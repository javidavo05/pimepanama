// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model AdminUser {
  id           String         @id @default(cuid())
  email        String         @unique
  passwordHash String
  role         AdminRole      @default(STAFF)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  sessions     AdminSession[]
}

model AdminSession {
  id        String    @id @default(cuid())
  user      AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  token     String    @unique
  createdAt DateTime  @default(now())
  expiresAt DateTime
}

enum AdminRole {
  OWNER
  STAFF
}

model Hero {
  id                  String   @id @default(cuid())
  headline_en         String
  headline_es         String
  subheadline_en      String
  subheadline_es      String
  highlight_en        String?
  highlight_es        String?
  backgroundImageUrl  String?
  backgroundVideoUrl  String?
  ctaPrimaryLabel_en  String?
  ctaPrimaryLabel_es  String?
  ctaPrimaryLink      String?
  ctaSecondaryLabel_en String?
  ctaSecondaryLabel_es String?
  ctaSecondaryLink    String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model PageSection {
  id         String   @id @default(cuid())
  slug       String   @unique
  title_en   String?
  title_es   String?
  subtitle_en String?
  subtitle_es String?
  body_en    String?
  body_es    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Service {
  id              String   @id @default(cuid())
  slug            String   @unique
  order           Int      @default(0)
  icon            String?
  imageUrl        String?
  title_en        String
  title_es        String
  description_en  String
  description_es  String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Sector {
  id             String   @id @default(cuid())
  slug           String   @unique
  order          Int      @default(0)
  title_en       String
  title_es       String
  description_en String?
  description_es String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Differentiator {
  id             String   @id @default(cuid())
  slug           String   @unique
  order          Int      @default(0)
  title_en       String
  title_es       String
  description_en String
  description_es String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model PortfolioItem {
  id                String   @id @default(cuid())
  slug              String   @unique
  order             Int      @default(0)
  imageUrl          String?
  clientName        String?
  industry_en       String?
  industry_es       String?
  title_en          String
  title_es          String
  summary_en        String
  summary_es        String
  outcome_en        String?
  outcome_es        String?
  caseStudyUrl      String?
  screenshots       String   @default("[]")
  techStack         String   @default("[]")
  highlights        String   @default("[]")
  liveUrl           String?
  repoUrl           String?
  category          String   @default("saas")
  featured          Boolean  @default(false)
  year              Int      @default(2024)
  value             Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model CallToAction {
  id              String   @id @default(cuid())
  slug            String   @unique
  order           Int      @default(0)
  eyebrow_en      String?
  eyebrow_es      String?
  title_en        String
  title_es        String
  description_en  String?
  description_es  String?
  buttonLabel_en  String?
  buttonLabel_es  String?
  buttonLink      String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model SeoSetting {
  id               String   @id @default(cuid())
  page             String   @unique
  metaTitle_en     String
  metaTitle_es     String
  metaDescription_en String
  metaDescription_es String
  ogImageUrl       String?
  keywords_en      String?
  keywords_es      String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

// ─── Pime Communications Suite ───────────────────────────────────────────────

enum EmpresaRole {
  OWNER
  USER
}

enum DocumentType {
  FACTURA
  COTIZACION
  BITACORA
  CORREO
}

enum DocumentStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  PAID
  CANCELLED
}

enum PaymentType {
  CASH
  BANK_TRANSFER
  CARD
  CHECK
  OTHER
}

enum ProjectStatus {
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

enum ContractStatus {
  DRAFT
  ACTIVE
  EXPIRED
  TERMINATED
}

enum ScheduleStatus {
  PENDING
  OVERDUE
  PAID
  CANCELLED
}

model EmpresaUser {
  id             String          @id @default(cuid())
  supabaseUid    String          @unique
  email          String          @unique
  fullName       String?
  role           EmpresaRole     @default(USER)
  documents      Document[]
  clients        Client[]
  paymentMethods PaymentMethod[]
  mailAccounts   MailAccount[]
  projects       Project[]
  contracts      Contract[]
  config         CompanyConfig?  @relation(fields: [configId], references: [id])
  configId       String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model Client {
  id        String      @id @default(cuid())
  name      String
  company   String?
  ruc       String?
  email     String?
  phone     String?
  address   String?
  city      String?
  country   String      @default("Panamá")
  notes     String?
  userId    String
  user      EmpresaUser @relation(fields: [userId], references: [id])
  documents Document[]
  projects  Project[]
  contracts Contract[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([userId])
}

model PaymentMethod {
  id             String      @id @default(cuid())
  name           String
  type           PaymentType @default(OTHER)
  commissionPct  Decimal     @default(0)
  commissionFlat Decimal     @default(0)
  commissionTax  Decimal     @default(0)
  bankName       String?
  accountNumber  String?
  accountType    String?
  accountHolder  String?
  isActive       Boolean     @default(true)
  userId         String
  user           EmpresaUser @relation(fields: [userId], references: [id])
  documents      Document[]
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([userId])
}

model CompanyConfig {
  id               String        @id @default(cuid())
  name             String        @default("Pime Panamá")
  legalName        String?
  ruc              String?
  address          String?
  city             String?
  country          String        @default("Panamá")
  phone            String?
  email            String?
  logoUrl          String?
  website          String?
  currency         String        @default("USD")
  defaultLocale    String        @default("es")
  invoicePrefix    String        @default("INV")
  quotePrefix      String        @default("COT")
  paymentTermsDays Int           @default(30)
  taxRatePercent   Decimal       @default(7)
  footerNotes_en   String?
  footerNotes_es   String?
  users            EmpresaUser[]
  documents        Document[]
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
}

model Document {
  id              String         @id @default(cuid())
  type            DocumentType
  status          DocumentStatus @default(DRAFT)
  language        String         @default("es")
  number          String?
  title           String
  clientName      String?
  clientEmail     String?
  clientCompany   String?
  clientAddress   String?
  clientRuc       String?
  content         Json           @default("{}")
  aiEnhanced      Boolean        @default(false)
  aiTokensUsed    Int            @default(0)
  issueDate       DateTime       @default(now())
  dueDate         DateTime?
  validUntil      DateTime?
  subtotal        Decimal?
  taxAmount       Decimal?
  total           Decimal?
  commissionAmt   Decimal?
  netAmount       Decimal?
  currency        String         @default("USD")
  user            EmpresaUser    @relation(fields: [userId], references: [id])
  userId          String
  client          Client?        @relation(fields: [clientId], references: [id])
  clientId        String?
  company         CompanyConfig? @relation(fields: [companyId], references: [id])
  companyId       String?
  paymentMethod   PaymentMethod? @relation(fields: [paymentMethodId], references: [id])
  paymentMethodId String?
  r2Key           String?
  pdfUrl          String?
  sentAt          DateTime?
  projectId        String?
  project          Project?        @relation(fields: [projectId], references: [id])
  contractId       String?
  contract         Contract?       @relation(fields: [contractId], references: [id])
  linkedDocumentId String?
  linkedDocument   Document?       @relation("DocumentLink", fields: [linkedDocumentId], references: [id])
  linkedBy         Document[]      @relation("DocumentLink")
  paymentSchedules PaymentSchedule[]
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([type, userId])
  @@index([status, userId])
  @@index([clientId])
  @@index([projectId])
  @@index([linkedDocumentId])
}

model AiUsageLog {
  id           String   @id @default(cuid())
  supabaseUid  String
  documentId   String?
  operation    String
  model        String
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  durationMs   Int      @default(0)
  createdAt    DateTime @default(now())
}

// ─── Proyectos, Contratos, Pagos ─────────────────────────────────────────────

model Project {
  id          String        @id @default(cuid())
  userId      String
  user        EmpresaUser   @relation(fields: [userId], references: [id])
  clientId    String?
  client      Client?       @relation(fields: [clientId], references: [id])
  name        String
  description String?
  scope       String?
  status      ProjectStatus @default(ACTIVE)
  startDate   DateTime?
  endDate     DateTime?
  totalBudget Decimal?
  aiSummary   String?
  aiTags      String[]
  documents   Document[]
  contracts   Contract[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([userId])
  @@index([userId, status])
}

model Contract {
  id               String         @id @default(cuid())
  userId           String
  user             EmpresaUser    @relation(fields: [userId], references: [id])
  projectId        String?
  project          Project?       @relation(fields: [projectId], references: [id])
  clientId         String?
  client           Client?        @relation(fields: [clientId], references: [id])
  title            String
  description      String?
  responsibilities String?
  terms            String?
  status           ContractStatus @default(DRAFT)
  signedAt         DateTime?
  startsAt         DateTime?
  endsAt           DateTime?
  value            Decimal?
  documents        Document[]
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([userId])
  @@index([projectId])
}

model PaymentSchedule {
  id           String         @id @default(cuid())
  userId       String
  documentId   String
  document     Document       @relation(fields: [documentId], references: [id], onDelete: Cascade)
  description  String
  amount       Decimal
  dueDate      DateTime
  status       ScheduleStatus @default(PENDING)
  paidAt       DateTime?
  invoiceId    String?
  reminderSent Boolean        @default(false)
  createdAt    DateTime       @default(now())

  @@index([userId, status])
  @@index([documentId])
  @@index([dueDate])
}

// ─── Mail Hub ────────────────────────────────────────────────────────────────

model MailAccount {
  id          String       @id @default(cuid())
  userId      String
  user        EmpresaUser  @relation(fields: [userId], references: [id])
  label       String
  host        String
  port        Int          @default(993)
  tls         Boolean      @default(true)
  username    String
  passwordEnc String
  credType    String       @default("PASSWORD_APP")
  smtpHost    String?
  smtpPort    Int?         @default(587)
  smtpTls     Boolean      @default(true)
  active      Boolean      @default(true)
  lastSyncAt  DateTime?
  emails      InboxEmail[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([userId])
}

model InboxEmail {
  id          String            @id @default(cuid())
  accountId   String
  account     MailAccount       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  userId      String
  uid         Int
  messageId   String?
  subject     String?
  fromName    String?
  fromEmail   String
  toAddresses String[]
  ccAddresses String[]
  bodyText    String?
  receivedAt  DateTime
  isRead      Boolean           @default(false)
  isStarred   Boolean           @default(false)
  folder      String            @default("INBOX")
  aiSummary   String?
  aiTags      String[]
  aiNotified  Boolean           @default(false)
  attachments EmailAttachment[]
  createdAt   DateTime          @default(now())

  @@unique([accountId, uid, folder])
  @@index([userId])
  @@index([accountId])
  @@index([receivedAt])
}

model EmailAttachment {
  id          String     @id @default(cuid())
  emailId     String
  email       InboxEmail @relation(fields: [emailId], references: [id], onDelete: Cascade)
  filename    String
  contentType String
  size        Int
  r2Key       String?
  r2Url       String?
  createdAt   DateTime   @default(now())
}

model MailNotification {
  id        String   @id @default(cuid())
  userId    String
  emailId   String?
  title     String
  body      String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read])
}
