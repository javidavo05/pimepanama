// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model AdminUser {
  id           String         @id @default(cuid())
  email        String         @unique
  passwordHash String
  role         AdminRole      @default(STAFF)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  sessions     AdminSession[]
}

model AdminSession {
  id        String    @id @default(cuid())
  user      AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  token     String    @unique
  createdAt DateTime  @default(now())
  expiresAt DateTime
}

enum AdminRole {
  OWNER
  STAFF
}

model Hero {
  id                   String   @id @default(cuid())
  headline_en          String
  headline_es          String
  subheadline_en       String
  subheadline_es       String
  highlight_en         String?
  highlight_es         String?
  backgroundImageUrl   String?
  backgroundVideoUrl   String?
  ctaPrimaryLabel_en   String?
  ctaPrimaryLabel_es   String?
  ctaPrimaryLink       String?
  ctaSecondaryLabel_en String?
  ctaSecondaryLabel_es String?
  ctaSecondaryLink     String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model PageSection {
  id          String   @id @default(cuid())
  slug        String   @unique
  title_en    String?
  title_es    String?
  subtitle_en String?
  subtitle_es String?
  body_en     String?
  body_es     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Service {
  id             String   @id @default(cuid())
  slug           String   @unique
  order          Int      @default(0)
  icon           String?
  imageUrl       String?
  title_en       String
  title_es       String
  description_en String
  description_es String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Sector {
  id             String   @id @default(cuid())
  slug           String   @unique
  order          Int      @default(0)
  title_en       String
  title_es       String
  description_en String?
  description_es String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Differentiator {
  id             String   @id @default(cuid())
  slug           String   @unique
  order          Int      @default(0)
  title_en       String
  title_es       String
  description_en String
  description_es String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model PortfolioItem {
  id           String   @id @default(cuid())
  slug         String   @unique
  order        Int      @default(0)
  imageUrl     String?
  clientName   String?
  industry_en  String?
  industry_es  String?
  title_en     String
  title_es     String
  summary_en   String
  summary_es   String
  outcome_en   String?
  outcome_es   String?
  caseStudyUrl String?
  screenshots  String   @default("[]")
  techStack    String   @default("[]")
  highlights   String   @default("[]")
  liveUrl      String?
  repoUrl      String?
  category     String   @default("saas")
  featured     Boolean  @default(false)
  year         Int      @default(2024)
  value        Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model CallToAction {
  id             String   @id @default(cuid())
  slug           String   @unique
  order          Int      @default(0)
  eyebrow_en     String?
  eyebrow_es     String?
  title_en       String
  title_es       String
  description_en String?
  description_es String?
  buttonLabel_en String?
  buttonLabel_es String?
  buttonLink     String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model SeoSetting {
  id                 String   @id @default(cuid())
  page               String   @unique
  metaTitle_en       String
  metaTitle_es       String
  metaDescription_en String
  metaDescription_es String
  ogImageUrl         String?
  keywords_en        String?
  keywords_es        String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

// ─── Pime Communications Suite ───────────────────────────────────────────────

enum EmpresaRole {
  OWNER
  USER
}

enum DocumentType {
  FACTURA
  COTIZACION
  BITACORA
  CORREO
}

enum DocumentStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  PAID
  PARTIALLY_PAID
  CANCELLED
}

enum PaymentType {
  CASH
  BANK_TRANSFER
  CARD
  CHECK
  OTHER
}

enum ProjectStatus {
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

enum ContractStatus {
  DRAFT
  ACTIVE
  EXPIRED
  TERMINATED
}

enum SigningStatus {
  DRAFT
  PENDING_CLIENT
  PENDING_COMPANY
  COMPLETED
  DECLINED
  EXPIRED
}

enum BookingStatus {
  CONFIRMED
  CANCELLED
  RESCHEDULED
}

enum BookingSource {
  PUBLIC
  EMPRESA
  LEAD_LINK
}

enum ScheduleStatus {
  PENDING
  OVERDUE
  PAID
  CANCELLED
}

model EmpresaUser {
  id                    String                   @id @default(cuid())
  supabaseUid           String                   @unique
  email                 String                   @unique
  fullName              String?
  role                  EmpresaRole              @default(USER)
  documents             Document[]
  clients               Client[]
  paymentMethods        PaymentMethod[]
  mailAccounts          MailAccount[]
  projects              Project[]
  contracts             Contract[]
  signingRequests       ContractSigningRequest[]
  bookingEventTypes     BookingEventType[]
  bookingAvailabilities BookingAvailability[]
  bookings              Booking[]
  leads                 Lead[]
  tasks                 Task[]
  platforms             Platform[]
  expenses              Expense[]
  meetings              Meeting[]
  config                CompanyConfig?           @relation(fields: [configId], references: [id])
  configId              String?
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt
}

model Client {
  id                 String          @id @default(cuid())
  name               String
  company            String?
  ruc                String?
  email              String?
  phone              String?
  address            String?
  city               String?
  country            String          @default("Panamá")
  notes              String?
  userId             String
  user               EmpresaUser     @relation(fields: [userId], references: [id])
  documents          Document[]
  projects           Project[]
  projectLinks       ProjectClient[]
  contracts          Contract[]
  meetings           Meeting[]
  convertedFromLeads Lead[]
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  @@index([userId])
}

enum LeadStatus {
  NUEVO
  CONTACTADO
  COTIZANDO
  NEGOCIACION
  GANADO
  PERDIDO
}

enum LeadSource {
  REFERIDO
  WEB
  REDES_SOCIALES
  FERIA
  LLAMADA_FRIA
  OTRO
}

model Lead {
  id                String      @id @default(cuid())
  name              String
  company           String?
  email             String?
  phone             String?
  address           String?
  city              String?
  country           String      @default("Panamá")
  source            LeadSource  @default(OTRO)
  status            LeadStatus  @default(NUEVO)
  estimatedValue    Decimal?
  notes             String?
  nextFollowUpAt    DateTime?
  lostReason        String?
  userId            String
  user              EmpresaUser @relation(fields: [userId], references: [id])
  documents         Document[]
  convertedClientId String?
  convertedClient   Client?     @relation(fields: [convertedClientId], references: [id])
  convertedAt       DateTime?
  bookings          Booking[]
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  @@index([userId])
  @@index([userId, status])
}

model PaymentMethod {
  id             String      @id @default(cuid())
  name           String
  type           PaymentType @default(OTHER)
  commissionPct  Decimal     @default(0)
  commissionFlat Decimal     @default(0)
  commissionTax  Decimal     @default(0)
  bankName       String?
  accountNumber  String?
  accountType    String?
  accountHolder  String?
  isActive       Boolean     @default(true)
  userId         String
  user           EmpresaUser @relation(fields: [userId], references: [id])
  documents      Document[]
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([userId])
}

model CompanyConfig {
  id                   String        @id @default(cuid())
  name                 String        @default("Pime Panamá")
  legalName            String?
  ruc                  String?
  address              String?
  city                 String?
  country              String        @default("Panamá")
  phone                String?
  email                String?
  logoUrl              String?
  website              String?
  currency             String        @default("USD")
  defaultLocale        String        @default("es")
  invoicePrefix        String        @default("INV")
  quotePrefix          String        @default("COT")
  paymentTermsDays     Int           @default(30)
  taxRatePercent       Decimal       @default(7)
  footerNotes_en       String?
  footerNotes_es       String?
  bookingAutoLead      Boolean       @default(true)
  signingMailAccountId String?
  users                EmpresaUser[]
  documents            Document[]
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
}

model Document {
  id               String             @id @default(cuid())
  type             DocumentType
  status           DocumentStatus     @default(DRAFT)
  language         String             @default("es")
  number           String?
  title            String
  clientName       String?
  clientEmail      String?
  clientCompany    String?
  clientAddress    String?
  clientRuc        String?
  content          Json               @default("{}")
  aiEnhanced       Boolean            @default(false)
  aiTokensUsed     Int                @default(0)
  issueDate        DateTime           @default(now())
  dueDate          DateTime?
  validUntil       DateTime?
  subtotal         Decimal?
  taxAmount        Decimal?
  total            Decimal?
  commissionAmt    Decimal?
  netAmount        Decimal?
  amountPaid       Decimal?
  currency         String             @default("USD")
  user             EmpresaUser        @relation(fields: [userId], references: [id])
  userId           String
  client           Client?            @relation(fields: [clientId], references: [id])
  clientId         String?
  lead             Lead?              @relation(fields: [leadId], references: [id])
  leadId           String?
  company          CompanyConfig?     @relation(fields: [companyId], references: [id])
  companyId        String?
  paymentMethod    PaymentMethod?     @relation(fields: [paymentMethodId], references: [id])
  paymentMethodId  String?
  r2Key            String?
  pdfUrl           String?
  sentAt           DateTime?
  projectId        String?
  project          Project?           @relation(fields: [projectId], references: [id])
  contractId       String?
  contract         Contract?          @relation(fields: [contractId], references: [id])
  linkedDocumentId String?
  linkedDocument   Document?          @relation("DocumentLink", fields: [linkedDocumentId], references: [id])
  linkedBy         Document[]         @relation("DocumentLink")
  paymentSchedules PaymentSchedule[]
  tasks            Task[]
  auditLogs        DocumentAuditLog[]
  meetings         Meeting[]          @relation("MeetingBitacora")
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@index([type, userId])
  @@index([status, userId])
  @@index([clientId])
  @@index([leadId])
  @@index([projectId])
  @@index([linkedDocumentId])
}

model AiUsageLog {
  id           String   @id @default(cuid())
  supabaseUid  String
  documentId   String?
  operation    String
  model        String
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  durationMs   Int      @default(0)
  createdAt    DateTime @default(now())
}

// ─── Proyectos, Contratos, Pagos ─────────────────────────────────────────────

model Project {
  id              String          @id @default(cuid())
  userId          String
  user            EmpresaUser     @relation(fields: [userId], references: [id])
  /// Espejo legacy del cliente principal. La fuente de verdad de "qué clientes
  /// pertenecen al proyecto" es la relación `clients` (tabla ProjectClient).
  clientId        String?
  client          Client?         @relation(fields: [clientId], references: [id])
  clients         ProjectClient[]
  name            String
  description     String?
  scope           String?
  status          ProjectStatus   @default(ACTIVE)
  startDate       DateTime?
  endDate         DateTime?
  totalBudget     Decimal?
  aiSummary       String?
  aiTags          String[]
  /// Contenido estructurado generado por IA para el PDF de propuesta (pilares, arquitectura, fases, alcance, cierre)
  proposalContent Json?
  /// Plan de financiación: abono inicial + cuotas mensuales/quincenales.
  /// Se materializa en PaymentSchedule al emitir la factura del proyecto.
  financingPlan   Json?
  deliverables    Deliverable[]
  meetings        Meeting[]
  documents       Document[]
  contracts       Contract[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([userId])
  @@index([userId, status])
}

model Deliverable {
  id           String              @id @default(cuid())
  projectId    String
  project      Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name         String
  description  String?
  dueDate      DateTime?
  completed    Boolean             @default(false)
  completedAt  DateTime?
  sortOrder    Int                 @default(0)
  /// MANUAL | AI_CONTRACT — de dónde salió el entregable
  source       String              @default("MANUAL")
  meetingItems MeetingActionItem[]
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@index([projectId])
  @@index([projectId, sortOrder])
}

model ProjectClient {
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([projectId, clientId])
  @@index([clientId])
  @@index([projectId])
}

model Contract {
  id                 String                  @id @default(cuid())
  userId             String
  user               EmpresaUser             @relation(fields: [userId], references: [id])
  projectId          String?
  project            Project?                @relation(fields: [projectId], references: [id])
  clientId           String?
  client             Client?                 @relation(fields: [clientId], references: [id])
  title              String
  description        String?
  responsibilities   String?
  terms              String?
  htmlContent        String?                 @db.Text
  status             ContractStatus          @default(DRAFT)
  signedAt           DateTime?
  signingStatus      SigningStatus?
  signingCompletedAt DateTime?
  startsAt           DateTime?
  endsAt             DateTime?
  value              Decimal?
  documents          Document[]
  signingRequest     ContractSigningRequest?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  @@index([userId])
  @@index([projectId])
}

model ContractSigningRequest {
  id                    String                 @id @default(cuid())
  contractId            String                 @unique
  contract              Contract               @relation(fields: [contractId], references: [id], onDelete: Cascade)
  userId                String
  user                  EmpresaUser            @relation(fields: [userId], references: [id], onDelete: Cascade)
  status                SigningStatus          @default(DRAFT)
  clientEmail           String
  companyEmail          String
  clientName            String?
  companyName           String?
  basePdfR2Key          String?
  clientSignatureR2Key  String?
  companySignatureR2Key String?
  signedPdfR2Key        String?
  expiresAt             DateTime
  tokens                ContractSigningToken[]
  events                ContractSigningEvent[]
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  @@index([userId])
}

model ContractSigningToken {
  id        String                 @id @default(cuid())
  requestId String
  request   ContractSigningRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  role      String
  tokenHash String                 @unique
  usedAt    DateTime?
  expiresAt DateTime
  createdAt DateTime               @default(now())

  @@index([requestId])
}

model ContractSigningEvent {
  id         String                 @id @default(cuid())
  requestId  String
  request    ContractSigningRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  action     String
  actorEmail String?
  ipAddress  String?
  userAgent  String?
  metadata   Json?
  createdAt  DateTime               @default(now())

  @@index([requestId])
}

model BookingEventType {
  id          String      @id @default(cuid())
  userId      String
  user        EmpresaUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  slug        String
  title       String
  durationMin Int         @default(30)
  bufferMin   Int         @default(10)
  description String?
  active      Boolean     @default(true)
  bookings    Booking[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@unique([userId, slug])
  @@index([userId])
}

model BookingAvailability {
  id        String      @id @default(cuid())
  userId    String
  user      EmpresaUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  weekday   Int
  startTime String
  endTime   String
  timezone  String      @default("America/Panama")
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([userId])
}

model Booking {
  id            String           @id @default(cuid())
  userId        String
  user          EmpresaUser      @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventTypeId   String
  eventType     BookingEventType @relation(fields: [eventTypeId], references: [id])
  leadId        String?
  lead          Lead?            @relation(fields: [leadId], references: [id], onDelete: SetNull)
  attendeeName  String
  attendeeEmail String
  attendeePhone String?
  startTime     DateTime
  endTime       DateTime
  status        BookingStatus    @default(CONFIRMED)
  notes         String?
  meetingUrl    String?
  source        BookingSource    @default(PUBLIC)
  taskId        String?
  task          Task?            @relation(fields: [taskId], references: [id], onDelete: SetNull)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@unique([userId, startTime])
  @@index([userId])
  @@index([leadId])
}

model PaymentSchedule {
  id           String         @id @default(cuid())
  userId       String
  documentId   String
  document     Document       @relation(fields: [documentId], references: [id], onDelete: Cascade)
  description  String
  amount       Decimal
  dueDate      DateTime
  status       ScheduleStatus @default(PENDING)
  paidAt       DateTime?
  invoiceId    String?
  reminderSent Boolean        @default(false)
  tasks        Task[]
  createdAt    DateTime       @default(now())

  @@index([userId, status])
  @@index([documentId])
  @@index([dueDate])
}

// ─── Tareas ──────────────────────────────────────────────────────────────────

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

model Task {
  id                String              @id @default(cuid())
  userId            String
  user              EmpresaUser         @relation(fields: [userId], references: [id])
  title             String
  description       String?
  assignee          String?
  priority          TaskPriority        @default(MEDIUM)
  dueDate           DateTime?
  endDate           DateTime?
  allDay            Boolean             @default(true)
  completed         Boolean             @default(false)
  completedAt       DateTime?
  reminderSent      Boolean             @default(false)
  documentId        String?
  document          Document?           @relation(fields: [documentId], references: [id])
  paymentScheduleId String?
  paymentSchedule   PaymentSchedule?    @relation(fields: [paymentScheduleId], references: [id])
  bookings          Booking[]
  meetingItems      MeetingActionItem[]
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@index([userId, completed])
  @@index([dueDate])
  @@index([documentId])
  @@index([paymentScheduleId])
}

// ─── Platforms registry ──────────────────────────────────────────────────────

model Platform {
  id                String      @id @default(cuid())
  userId            String
  user              EmpresaUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  name              String
  accessUrl         String?
  supabaseEmail     String?
  supabaseSlot      Int?
  vercelEmail       String?
  vercelSlot        Int?
  linkUrl           String?
  githubEmail       String?
  brevoEmail        String?
  notes             String?
  confidentialVault String?
  sortOrder         Int         @default(0)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  @@index([userId])
  @@index([userId, sortOrder])
}

// ─── Por pagar (gastos) ──────────────────────────────────────────────────────

enum ExpenseStatus {
  PENDING
  PAID
  CANCELLED
}

enum ExpenseCategory {
  HOSTING
  SAAS
  SALARIOS
  SERVICIOS
  MARKETING
  IMPUESTOS
  COMISIONES
  SOFTWARE
  OTRO
}

model Expense {
  id          String          @id @default(cuid())
  userId      String
  user        EmpresaUser     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  category    ExpenseCategory @default(OTRO)
  amount      Decimal
  currency    String          @default("USD")
  dueDate     DateTime?
  paidAt      DateTime?
  status      ExpenseStatus   @default(PENDING)
  isRecurring Boolean         @default(false)
  vendor      String?
  notes       String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([userId, status])
  @@index([userId, dueDate])
}

// ─── Mail Hub ────────────────────────────────────────────────────────────────

model MailAccount {
  id               String       @id @default(cuid())
  userId           String
  user             EmpresaUser  @relation(fields: [userId], references: [id])
  label            String
  host             String
  port             Int          @default(993)
  tls              Boolean      @default(true)
  username         String
  passwordEnc      String
  credType         String       @default("PASSWORD_APP")
  smtpHost         String?
  smtpPort         Int?         @default(587)
  smtpTls          Boolean      @default(true)
  fromName         String?
  signatureName    String?
  signatureTitle   String?
  signatureEnabled Boolean      @default(true)
  signatureHtml    String?
  active           Boolean      @default(true)
  lastSyncAt       DateTime?
  emails           InboxEmail[]
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([userId])
}

model InboxEmail {
  id               String            @id @default(cuid())
  accountId        String
  account          MailAccount       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  userId           String
  uid              Int
  messageId        String?
  inReplyTo        String?
  referencesHeader String?
  threadKey        String?
  repliedToEmailId String?
  deliveryStatus   String?
  smtpAccepted     String[]          @default([])
  smtpRejected     String[]          @default([])
  smtpResponse     String?
  resendId         String?
  deliveredAt      DateTime?
  openedAt         DateTime?
  bouncedAt        DateTime?
  bounceReason     String?
  subject          String?
  fromName         String?
  fromEmail        String
  toAddresses      String[]
  ccAddresses      String[]
  bodyText         String?
  receivedAt       DateTime
  isRead           Boolean           @default(false)
  isStarred        Boolean           @default(false)
  folder           String            @default("INBOX")
  aiSummary        String?
  aiTags           String[]
  aiNotified       Boolean           @default(false)
  attachments      EmailAttachment[]
  createdAt        DateTime          @default(now())

  @@unique([accountId, uid, folder])
  @@index([userId])
  @@index([userId, folder, receivedAt])
  @@index([userId, threadKey])
  @@index([resendId])
  @@index([accountId])
  @@index([receivedAt])
}

model EmailAttachment {
  id          String     @id @default(cuid())
  emailId     String
  email       InboxEmail @relation(fields: [emailId], references: [id], onDelete: Cascade)
  filename    String
  contentType String
  size        Int
  r2Key       String?
  r2Url       String?
  createdAt   DateTime   @default(now())
}

// ─── Auditoría de ediciones a documentos ─────────────────────────────────────

model DocumentAuditLog {
  id         String   @id @default(cuid())
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  actorEmail String
  actorName  String?
  summary    String
  createdAt  DateTime @default(now())

  @@index([documentId])
}

model MailNotification {
  id        String   @id @default(cuid())
  userId    String
  emailId   String?
  link      String?
  title     String
  body      String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read])
}

// ─── PimeMeet: reuniones grabadas → minutas, pendientes y prompt técnico ─────

enum MeetingStatus {
  DRAFT
  RECORDING
  TRANSCRIBED
  PROCESSING
  READY
  FAILED
}

enum MeetingItemKind {
  TECNICO
  COMERCIAL
  ADMINISTRATIVO
  DECISION
  RIESGO
}

model Meeting {
  id               String              @id @default(cuid())
  userId           String
  user             EmpresaUser         @relation(fields: [userId], references: [id])
  projectId        String?
  project          Project?            @relation(fields: [projectId], references: [id])
  clientId         String?
  client           Client?             @relation(fields: [clientId], references: [id])
  /// Bitácora (Document tipo BITACORA) emitida a partir de esta reunión
  bitacoraId       String?
  bitacora         Document?           @relation("MeetingBitacora", fields: [bitacoraId], references: [id])
  title            String
  language         String              @default("es")
  status           MeetingStatus       @default(DRAFT)
  meetingDate      DateTime            @default(now())
  durationMs       Int                 @default(0)
  /// Asistentes esperados: [{ name, org: "PIME"|"CLIENTE", role }]
  attendees        Json                @default("[]")
  /// Segmentos de Whisper con timestamps: [{ start, end, text, speaker }]
  segments         Json                @default("[]")
  transcript       String?
  /// Transcripción ya atribuida a hablantes, en markdown
  diarizedText     String?
  /// Minuta ejecutiva (cliente): { agenda, decisions[], risks[], nextSteps, nextMeeting }
  executiveMinutes Json?
  /// Minuta técnica (equipo): { summary, architecture, changes[], dependencies[], openQuestions[] }
  technicalMinutes Json?
  /// Prompt listo para pegarle a un agente de código
  technicalPrompt  String?
  /// Resumen corto que alimenta el contexto acumulado del proyecto
  contextSummary   String?
  /// Contexto escrito a mano por el usuario después de grabar; entra al prompt junto al del proyecto
  manualContext    String?
  audioKeys        String[]
  aiCostUSD        Float               @default(0)
  errorMessage     String?
  speakers         MeetingSpeaker[]
  actionItems      MeetingActionItem[]
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@index([userId])
  @@index([projectId])
  @@index([clientId])
  @@index([userId, meetingDate])
}

model MeetingSpeaker {
  id           String   @id @default(cuid())
  meetingId    String
  meeting      Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  /// Etiqueta cruda del diarizador ("Hablante 1")
  label        String
  /// Nombre resuelto contra la lista de asistentes (null si no se pudo)
  name         String?
  /// PIME | CLIENTE | DESCONOCIDO
  org          String   @default("DESCONOCIDO")
  segmentCount Int      @default(0)
  talkMs       Int      @default(0)
  createdAt    DateTime @default(now())

  @@index([meetingId])
}

model MeetingActionItem {
  id            String          @id @default(cuid())
  meetingId     String
  meeting       Meeting         @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  title         String
  detail        String?
  kind          MeetingItemKind @default(TECNICO)
  owner         String?
  dueDate       DateTime?
  priority      TaskPriority    @default(MEDIUM)
  /// Criterios de aceptación — alimentan el prompt técnico
  acceptance    String[]
  /// Módulos/archivos/pantallas que toca según lo hablado
  touchpoints   String[]
  estimateHours Float?
  sortOrder     Int             @default(0)
  taskId        String?
  task          Task?           @relation(fields: [taskId], references: [id])
  deliverableId String?
  deliverable   Deliverable?    @relation(fields: [deliverableId], references: [id])
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([meetingId])
  @@index([meetingId, sortOrder])
  @@index([taskId])
}
