# Supabase — pimepanama (project ref: onodhoqfybzmpaorhyve)
# Copy to .env.local and fill in values. Never commit .env.local.

# Option A: paste full URIs from Supabase Dashboard → Settings → Database
DATABASE_URL="postgresql://postgres.onodhoqfybzmpaorhyve:[PASSWORD]@aws-1-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.onodhoqfybzmpaorhyve:[PASSWORD]@aws-1-us-east-1.pooler.supabase.com:5432/postgres"

# Option B: only the DB password (scripts build URLs automatically)
# SUPABASE_DB_PASSWORD=
# SUPABASE_POOLER_HOST=aws-1-us-east-1.pooler.supabase.com

# Admin panel login (created by npm run db:setup-supabase)
ADMIN_SEED_EMAIL="founder@pimepanama.com"
ADMIN_SEED_PASSWORD="ChangeMe123!"

# Optional — for future Supabase client features (not used by Prisma)
NEXT_PUBLIC_SUPABASE_URL="https://onodhoqfybzmpaorhyve.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# Site
NEXT_PUBLIC_SITE_URL="https://pimepanama.com"

# Pime Communications Suite (/empresa) — OpenAI
OPENAI_API_KEY="sk-..."

# Mail Hub — encrypts IMAP account passwords at rest (AES-256-GCM)
# Generate: openssl rand -hex 32  → 64 hex chars. Must match across all deploys.
MAIL_ENCRYPTION_KEY=""

# Cloudflare R2 — mail attachments + empresa uploads
# Requerido en Vercel para Mail Hub (adjuntos) y uploads de empresa
R2_ACCOUNT_ID=""
R2_BUCKET_NAME="pime-suite"
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""

# PimeSign — firma digital de contratos
# Generate: openssl rand -hex 32
SIGNING_TOKEN_SECRET=""
SIGNING_LINK_TTL_DAYS=14

# PimeBook — agenda de citas
BOOKING_OWNER_EMAIL=""
BOOKING_DEFAULT_TIMEZONE="America/Panama"
BOOKING_MIN_NOTICE_HOURS=2

# Resend — envío saliente (Mail Hub, contacto, PimeSign, PimeBook)
# API key: https://resend.com/api-keys — nunca commitear la key real
RESEND_API_KEY="re_xxxxxxxxx"
# From verificado en Resend (dominio verificado en dashboard)
RESEND_FROM="PIME Panama <noreply@mail.pimepanama.com>"
# Webhook signing secret: Resend Dashboard → Webhooks → signing secret
RESEND_WEBHOOK_SECRET="whsec_..."
# Opcional: dominios permitidos para from por cuenta (coma-separados). Si vacío, se infiere de RESEND_FROM.
# RESEND_ALLOWED_DOMAINS="mail.pimepanama.com,pimepanama.com"
